{
  "name": "agent-lighthouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kane-powered booking measurements, repair proposals and proof for owner review.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "demo:reset": "node scripts/reset.mjs",
    "loop": "node lighthouse/cli.mjs loop",
    "kane:replay": "KANE_CLI_USER_AGENT=codex kane-cli testmd run tests/kane/human-path_test.md --agent --headless",
    "dashboard": "node scripts/dashboard.mjs",
    "report": "node lighthouse/report.mjs",
    "baseline": "node lighthouse/measure.mjs",
    "build:fixtures": "node scripts/build-fixtures.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  },
  "bin": {
    "lighthouse": "lighthouse/cli.mjs"
  }
}
